# Build artifacts
/target/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git worktrees (used for parallel agent work)
.worktrees/

# Serena
.serena/

# Skill scratch directories (created during /audit and /check runs)
.audit/
.check/

# Coverage reports (downloaded CI artifacts and local generation)
coverage-report/
lcov.info
*.profraw
*.profdata

# tui-test capture artifacts (generated by E2E tests)
tui-test-captures/

# Environment
.env
.env.local

# Tooling configuration
.mcp.json
opencode.json
.opencode/

# Claude Code local settings
.claude/settings.local.json

# Skill variant build output
/dist/

# Benchmark result files (generated by benches/, not source)
benches/*_results*.json

# Session recordings
*.cast

# Coding-agent review-findings dirs. Automated review tooling writes these at
# the repo root of a working tree. They hold internal run identifiers and raw
# review commentary, so a broad `git add -A` must never sweep them into a PR.
.architect/
.reviewer/

